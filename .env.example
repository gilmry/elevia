# Copy to .env and adjust before running `docker compose up`

# --- Postgres ---
POSTGRES_DB=elevia
POSTGRES_USER=elevia
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql://elevia:change-me@postgres:5432/elevia
JWT_SECRET=change-me-too-please-use-a-long-random-string
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info
# There is no public endpoint to create the first admin account (every /admin/...
# endpoint requires an existing admin token). On first boot, if no admin exists
# yet, the backend creates one from these two variables - after that, log in and
# create further accounts via POST /admin/exploitations instead.
ADMIN_EMAIL=admin@elevia.local
ADMIN_PASSWORD=change-me-immediately

# --- Frontend ---
# FRONTEND_PORT only applies to `--profile dev` (direct Astro dev server port);
# the production frontend/backend are reached via Traefik on 80/443 below.
FRONTEND_PORT=4321
# Base URL the PWA uses to reach the backend API - also read by the backend
# itself (prod only) as its own public URL for the OAuth issuer/endpoint URLs
# in /.well-known/oauth-authorization-server, since Traefik doesn't reliably
# set X-Forwarded-Host. Defaults here to the --profile dev value (direct
# backend port, no Traefik) - for --profile prod, set this to
# https://<API_DOMAIN> instead.
PUBLIC_API_URL=http://localhost:8080

# --- Traefik / TLS (production) ---
# Point both DNS A records at this host before `docker compose up`.
DOMAIN=elevia.ecosolva.org
API_DOMAIN=api.elevia.ecosolva.org
# Used by Let's Encrypt for expiry/revocation notices
ACME_EMAIL=admin@ecosolva.com
